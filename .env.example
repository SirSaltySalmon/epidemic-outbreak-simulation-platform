# Copy to .env and adjust. Pydantic loads these with prefix EOSP_ (see app/eosp/core/settings.py).

# --- Core
EOSP_ENV=development
EOSP_DATABASE_URL=postgresql+psycopg://eosp:eosp_dev_password@127.0.0.1:5432/eosp
EOSP_REDIS_URL=redis://127.0.0.1:6379/0

# --- WHO DON event poll (optional ingestion)
EOSP_WHO_DON_POLL_ENABLED=false
# Automated WHO DON hub->item ingest is deprecated (manual data entry preferred). Set true only to experiment.
EOSP_WHO_DON_URL=https://www.who.int/emergencies/emergency-events/item/2026-e000227
EOSP_WHO_DON_POLL_INTERVAL_SECONDS=21600
EOSP_WHO_DON_FEED_KEY=who_don_2026_e000227
# latest_only | all_discovered
EOSP_WHO_DON_ITEM_POLICY=all_discovered
# regex | llm | hybrid — hybrid uses focus-window regex, then OpenAI-compatible API if needed
EOSP_WHO_DON_EXTRACT_MODE=hybrid
EOSP_WHO_DON_EXTRACT_MAX_COHORT=500
# EOSP_WHO_DON_LLM_API_KEY=
EOSP_WHO_DON_LLM_BASE_URL=https://api.openai.com/v1
EOSP_WHO_DON_LLM_MODEL=gpt-4o-mini
EOSP_WHO_DON_LLM_TIMEOUT_SECONDS=60

# pytest only (no EOSP_ prefix): live WHO hub -> DON item -> extract
# (tests/test_who_don_future_page_extract.py::test_who_don_live_hub_crawl_and_item_extract)
# WHO_DON_LIVE=1

# --- Geo risk map (GET /api/v1/geo/outbreak)
# Default heatmap when ``risk_model`` query is omitted: legacy (OpenSky rings) | metapop | abm_geo
EOSP_GEO_RISK_MODEL=abm_geo
# Deprecated product surface: stochastic metapop kernel (research/regression only).
EOSP_METAPOP_ENABLED=false
# Path to mobility JSON or Parquet (when metapop enabled). Unset = skeleton schedule.
# EOSP_METAPOP_MOBILITY=app/eosp/data/bundles/openflights_routes.json
EOSP_METAPOP_RUNS=64
EOSP_METAPOP_SEED=20260507

# --- Clerk (https://clerk.com): set both to require signed-in sessions for researcher APIs + Console UI.
EOSP_CLERK_PUBLISHABLE_KEY=pk_test_...
EOSP_CLERK_FRONTEND_API=https://YOUR_INSTANCE.clerk.accounts.dev
# Backend-only: Use the Secret Key from Clerk Dashboard → API Keys (must start with sk_test_ or sk_live_).
# Required for Console authorization unless you embed console_access in the session JWT (Customize session token).
# Direct api.clerk.com calls require an API version header; override only if Clerk docs tell you to:
# EOSP_CLERK_BACKEND_API_VERSION=2025-04-10
EOSP_CLERK_SECRET_KEY=sk_test_...

# --- Inference / ensemble (read in app/eosp/main.py job defaults)
# EOSP_ENSEMBLE_SIMULATIONS=10000
# EOSP_NUTS_WARMUP=1000
# EOSP_NUTS_SAMPLES=2000
# EOSP_NUTS_CHAINS=4
